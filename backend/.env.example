NODE_ENV=development
PORT=4000

# PostgreSQL (local, or the free Supabase Postgres connection string)
DATABASE_URL=postgresql://user:password@localhost:5432/levelup
DATABASE_SSL=false

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_HOURS=8

# Origin of the front-end (no trailing path)
CLIENT_URL=http://localhost:5173
# lax | strict | none (use none only if front-end and API are on different sites; requires HTTPS)
COOKIE_SAMESITE=lax

# Google OAuth (free) - see backend/README.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# First Super Admin (used by npm run db:seed-admin). Leave the password empty for Google-only login.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=
SUPER_ADMIN_PASSWORD=
